#!/usr/bin/env bash
set -euo pipefail

: "${DEVENV_ROOT:?Run vega-pi-sync from the repository devenv}"
: "${LINK_AGENT_IMAGE:?Set LINK_AGENT_IMAGE to the same immutable agent image used by k8s-apply-link}"

if [[ ! "$LINK_AGENT_IMAGE" =~ ^ghcr\.io/ai-outfitter/link-agent@sha256:[0-9a-f]{64}$ ]]; then
  echo "vega-pi-sync: LINK_AGENT_IMAGE must be an immutable Link Agent GHCR digest" >&2
  exit 1
fi
if [[ ! -d "$HOME/.pi" ]]; then
  echo "vega-pi-sync: local Pi configuration not found at $HOME/.pi" >&2
  exit 1
fi

export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config.ocean.yml}"
expected_server="${K8S_EXPECTED_SERVER:-https://100.64.0.6:6443}"
actual_server="$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
if [[ "$actual_server" != "$expected_server" ]]; then
  echo "vega-pi-sync: refusing cluster server '$actual_server'; expected '$expected_server'" >&2
  exit 1
fi

namespace=agent-vega
pod=vega-pi-seeder
kubectl -n "$namespace" wait --for=jsonpath='{.status.phase}'=Bound pvc/agent-workspace --timeout=5m
kubectl -n "$namespace" delete pod "$pod" --ignore-not-found --wait=true

temporary="$(mktemp)"
trap 'rm -f "$temporary"; kubectl -n "$namespace" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true' EXIT
sed "s#__LINK_AGENT_IMAGE__#$LINK_AGENT_IMAGE#g" \
  "$DEVENV_ROOT/k8s-cluster/link-operator/vega-pi-seeder.yaml" > "$temporary"
kubectl apply -f "$temporary"
kubectl -n "$namespace" wait --for=condition=Ready "pod/$pod" --timeout=3m

tar -C "$HOME" -cf - .pi | kubectl -n "$namespace" exec -i "$pod" -- tar -C /workspace -xf -
kubectl -n "$namespace" exec "$pod" -- test -d /workspace/.pi/agent
if [[ -f "$HOME/.pi/agent/auth.json" ]]; then
  kubectl -n "$namespace" exec "$pod" -- test -s /workspace/.pi/agent/auth.json
fi
kubectl -n "$namespace" delete pod "$pod" --wait=true
kubectl -n "$namespace" create configmap vega-pi-ready \
  --from-literal=LINK_PI_CONFIG_READY=true \
  --dry-run=client -o yaml | kubectl apply --server-side --field-manager=vega-pi-sync -f -

trap - EXIT
rm -f "$temporary"
echo "Copied local Pi configuration directly into Vega's workspace PVC."
